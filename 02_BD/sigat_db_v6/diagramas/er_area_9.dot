digraph G {
 rankdir=LR; splines=true; nodesep=0.35; ranksep=0.9; fontname="Helvetica";
 node [shape=plain fontname="Helvetica" fontsize=9]; edge [color="#555555" arrowsize=0.7];
 archivo_adjunto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>archivo_adjunto</B></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_id"><B>arch_id</B> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_clase">arch_clase <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_nombre_original">arch_nombre_original <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_mime">arch_mime <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_tamano_bytes">arch_tamano_bytes <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_hash_sha256">arch_hash_sha256 <FONT COLOR="#777777">character(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_paginas">arch_paginas <FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_ref_almacenamiento">arch_ref_almacenamiento <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_estado">arch_estado <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_motivo_rechazo">arch_motivo_rechazo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><I>usua_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="disp_id"><I>disp_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_t_captura">arch_t_captura <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_t_sincronizacion">arch_t_sincronizacion <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_t_almacenado">arch_t_almacenado <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 categoria_notificacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>categoria_notificacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="cate_id"><B>cate_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cate_codigo">cate_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cate_descripcion">cate_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 evidencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>evidencia</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evid_id"><B>evid_id</B> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_id"><I>arch_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evid_clase"><I>evid_clase</I> <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lect_id"><I>lect_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hall_id"><I>hall_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evid_observacion">evid_observacion <FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evid_geom">evid_geom <FONT COLOR="#777777">geometry(Point,4326)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evid_precision_m">evid_precision_m <FONT COLOR="#777777">real</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><I>usua_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="disp_id"><I>disp_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_id"><I>oper_id</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evid_t_sincronizacion">evid_t_sincronizacion <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 imagen_diseno [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>imagen_diseno</B></TD></TR><TR><TD ALIGN="LEFT" PORT="imag_id"><B>imag_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="imag_codigo">imag_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="imag_version">imag_version <FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="imag_uso">imag_uso <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_id"><I>arch_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_clase"><I>arch_clase</I> <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="imag_activa">imag_activa <FONT COLOR="#777777">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="imag_creada_en">imag_creada_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 notificacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>notificacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_id"><B>noti_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><I>usua_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cate_id"><I>cate_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_titulo">noti_titulo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_cuerpo">noti_cuerpo <FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_evento_clave">noti_evento_clave <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_destino_ruta">noti_destino_ruta <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_destino_argumento">noti_destino_argumento <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_creada_en">noti_creada_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="noti_leida_en">noti_leida_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 perfil_usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>perfil_usuario</B></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><B>usua_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_id_foto"><I>arch_id_foto</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perf_foto_clase"><I>perf_foto_clase</I> <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perf_notificaciones_activas">perf_notificaciones_activas <FONT COLOR="#777777">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perf_actualizado_en">perf_actualizado_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 planificacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>planificacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id"><B>plan_id</B> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id_destinatario"><I>usua_id_destinatario</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id_creador"><I>usua_id_creador</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_actividad">plan_actividad <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_fecha_inicio">plan_fecha_inicio <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_fecha_fin">plan_fecha_fin <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_hora_desde">plan_hora_desde <FONT COLOR="#777777">time without time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_hora_hasta">plan_hora_hasta <FONT COLOR="#777777">time without time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_observaciones">plan_observaciones <FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arch_id_documento"><I>arch_id_documento</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_documento_clase"><I>plan_documento_clase</I> <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_estado">plan_estado <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_motivo_rechazo">plan_motivo_rechazo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_respondida_en">plan_respondida_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_creada_en">plan_creada_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 planificacion_lote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>planificacion_lote</B></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id"><B>plan_id</B> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lote_id"><B>lote_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 preferencia_notificacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>preferencia_notificacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><B>usua_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cate_id"><B>cate_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pref_habilitada">pref_habilitada <FONT COLOR="#777777">boolean</FONT></TD></TR></TABLE>>];
 restablecimiento_clave [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fee2e2" ALIGN="LEFT"><B>restablecimiento_clave</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rest_id"><B>rest_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><I>usua_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rest_token_hash">rest_token_hash <FONT COLOR="#777777">character(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rest_solicitado_en">rest_solicitado_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rest_expira_en">rest_expira_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rest_usado_en">rest_usado_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 evidencia -> archivo_adjunto;
 imagen_diseno -> archivo_adjunto;
 perfil_usuario -> archivo_adjunto;
 preferencia_notificacion -> categoria_notificacion;
 notificacion -> categoria_notificacion;
 planificacion -> archivo_adjunto;
 planificacion_lote -> planificacion;
}