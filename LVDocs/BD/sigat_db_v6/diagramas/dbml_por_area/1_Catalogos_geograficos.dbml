Project sigat { database_type: 'PostgreSQL' }

Table arbol {
  arbo_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  arbo_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
}

Table atrayente {
  atra_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  atra_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  atra_vida_util_min_sem smallint [note: '[ud: semanas] Vida útil mínima de campo del atrayente (RN-008).']
  atra_vida_util_max_sem smallint [note: '[ud: semanas] Vida útil máxima de campo del atrayente (RN-008).']
}

Table centro_acopio {
  cent_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  cent_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  depa_id integer [not null, note: 'Referencia a departamento(depa_id).']
}

Table condicion_trampa {
  cond_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  cond_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  cond_activa boolean [not null, default: `true`, note: 'Falso = valor retirado del catálogo (se conserva por historia).']
}

Table departamento {
  depa_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  depa_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  regi_id integer [not null, note: 'Referencia a region(regi_id).']
  depa_codigo character(2) [unique, note: 'Código DANE del departamento (2 dígitos). Fuente a cargar desde DANE.']
}

Table escenario_trampeo {
  esce_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  esce_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  esce_orden smallint [not null, unique, note: 'Orden de presentación (de mayor a menor gravedad).']
  esce_mtd_desde_defecto numeric(10,4) [note: '[ud: moscas/trampa/día] Límite inferior de referencia del escenario.']
  esce_mtd_hasta_defecto numeric(10,4) [note: '[ud: moscas/trampa/día] Límite superior de referencia; nulo = sin límite superior.']
  esce_fuente varchar [note: 'Fuente documental de los límites por defecto (p. ej. Levantamiento RN-002, Tabla 1, OIEA 2005).']
}

Table especie_cultivo {
  espc_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  espc_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
}

Table especie_mosca {
  espm_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  espm_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  espm_codigo smallint [unique, note: 'Código numérico de la especie en el catálogo de captura (1 = Ceratitis capitata, 51 = No captura, 54 = No Tephritidae, 56 = Anastrepha sp.). Nulo para especies agregadas localmente.']
  espm_tipo varchar [not null, default: `'especie'::character varying`, note: 'Naturaleza del resultado de determinación: especie, genero_sin_especie, sin_captura o no_tephritidae.']
}

Table estado_registro {
  esta_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  esta_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
}

Table fenologia {
  feno_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  feno_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  feno_codigo smallint [unique, note: 'Código numérico de la etapa fenológica (nulo si la etapa no tiene código).']
}

Table localizacion {
  loca_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  loca_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  loca_codigo smallint [unique, note: 'Código numérico de la localización de la trampa.']
}

Table municipio {
  muni_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  muni_descripcion varchar [not null, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  depa_id integer [not null, note: 'Referencia a departamento(depa_id).']
  muni_codigo character(3) [note: 'Código DANE del municipio dentro del departamento (3 dígitos).']
  indexes {
    (depa_id, muni_codigo) [unique]
  }
}

Table norma {
  norm_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  norm_codigo varchar [not null, unique, note: 'Identificador corto único de la norma.']
  norm_titulo varchar [not null, note: 'Título completo de la norma.']
  norm_emisor varchar [not null, note: 'Entidad que expide la norma.']
  norm_anio smallint [note: 'Año de expedición de la norma.']
  norm_texto_disponible boolean [not null, default: `false`, note: 'Falso si el equipo aún no dispone del texto de la norma.']
}

Table producto_fitosanitario {
  prof_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  prof_nombre varchar [not null, unique, note: 'Nombre comercial (único).']
  prof_ingrediente_activo varchar [note: 'Ingrediente activo (opcional).']
  prof_registro varchar [unique, note: 'Número de registro oficial del producto (opcional, único).']
  prof_activo boolean [not null, default: `true`, note: 'Falso = producto retirado del catálogo.']
}

Table rango_departamento {
  depa_id integer [pk, not null, note: 'Referencia a departamento(depa_id).']
  rang_long_min float8 [not null, note: '[ud: grados] Longitud mínima de la caja del departamento.']
  rang_long_max float8 [not null, note: '[ud: grados] Longitud máxima de la caja del departamento.']
  rang_lat_min float8 [not null, note: '[ud: grados] Latitud mínima de la caja del departamento.']
  rang_lat_max float8 [not null, note: '[ud: grados] Latitud máxima de la caja del departamento.']
}

Table region {
  regi_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  regi_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
}

Table rol {
  rol_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  rol_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  rol_codigo varchar [unique, note: 'Código estable del rol para el código de aplicación (MAYÚSCULAS_Y_GUION_BAJO).']
  rol_ambito varchar [not null, default: `'predio'::character varying`, note: 'global (rige en todo el sistema) o predio (rige sobre los predios asignados).']
}

Table tipo_trampa {
  tipt_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  tipt_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  tipt_paridad varchar [note: 'impar o par: paridad que debe cumplir el número de trampa (RN-005). Nulo = sin regla.']
}

Table unidad_medida {
  unid_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  unid_simbolo varchar [not null, unique, note: 'Símbolo de la unidad (único), p. ej. kg, ha, mL/L.']
  unid_nombre varchar [not null, note: 'Nombre de la unidad.']
  unid_magnitud varchar [not null, note: 'Magnitud: masa, area, volumen, longitud o concentracion.']
}

Table variedad_cultivo {
  vari_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  espc_id integer [not null, note: 'Referencia a especie_cultivo(espc_id).']
  vari_descripcion varchar [not null, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  indexes {
    (espc_id, vari_descripcion) [unique]
    (espc_id, vari_id) [unique]
  }
}

Table vigilancia {
  vigi_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  vigi_descripcion varchar [not null, unique, note: 'Texto descriptivo del valor del catálogo (único, no vacío).']
  vigi_codigo smallint [unique, note: 'Código numérico del tipo de vigilancia.']
}

Ref: departamento.regi_id > region.regi_id
Ref: municipio.depa_id > departamento.depa_id
Ref: rango_departamento.depa_id > departamento.depa_id
Ref: centro_acopio.depa_id > departamento.depa_id
Ref: variedad_cultivo.espc_id > especie_cultivo.espc_id
