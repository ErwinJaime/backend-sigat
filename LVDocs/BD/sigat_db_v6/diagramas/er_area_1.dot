digraph G {
 rankdir=LR; splines=true; nodesep=0.35; ranksep=0.9; fontname="Helvetica";
 node [shape=plain fontname="Helvetica" fontsize=9]; edge [color="#555555" arrowsize=0.7];
 arbol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>arbol</B></TD></TR><TR><TD ALIGN="LEFT" PORT="arbo_id"><B>arbo_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arbo_descripcion">arbo_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 atrayente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>atrayente</B></TD></TR><TR><TD ALIGN="LEFT" PORT="atra_id"><B>atra_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atra_descripcion">atra_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atra_vida_util_min_sem">atra_vida_util_min_sem <FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atra_vida_util_max_sem">atra_vida_util_max_sem <FONT COLOR="#777777">smallint</FONT></TD></TR></TABLE>>];
 centro_acopio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>centro_acopio</B></TD></TR><TR><TD ALIGN="LEFT" PORT="cent_id"><B>cent_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cent_descripcion">cent_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="depa_id"><I>depa_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 condicion_trampa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>condicion_trampa</B></TD></TR><TR><TD ALIGN="LEFT" PORT="cond_id"><B>cond_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cond_descripcion">cond_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cond_activa">cond_activa <FONT COLOR="#777777">boolean</FONT></TD></TR></TABLE>>];
 departamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>departamento</B></TD></TR><TR><TD ALIGN="LEFT" PORT="depa_id"><B>depa_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="depa_descripcion">depa_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="regi_id"><I>regi_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="depa_codigo">depa_codigo <FONT COLOR="#777777">character(2)</FONT></TD></TR></TABLE>>];
 escenario_trampeo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>escenario_trampeo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_id"><B>esce_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_descripcion">esce_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_orden">esce_orden <FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_mtd_desde_defecto">esce_mtd_desde_defecto <FONT COLOR="#777777">numeric(10,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_mtd_hasta_defecto">esce_mtd_hasta_defecto <FONT COLOR="#777777">numeric(10,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_fuente">esce_fuente <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 especie_cultivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>especie_cultivo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="espc_id"><B>espc_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="espc_descripcion">espc_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 especie_mosca [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>especie_mosca</B></TD></TR><TR><TD ALIGN="LEFT" PORT="espm_id"><B>espm_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="espm_descripcion">espm_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="espm_codigo">espm_codigo <FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="espm_tipo">espm_tipo <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 estado_registro [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>estado_registro</B></TD></TR><TR><TD ALIGN="LEFT" PORT="esta_id"><B>esta_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esta_descripcion">esta_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 fenologia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>fenologia</B></TD></TR><TR><TD ALIGN="LEFT" PORT="feno_id"><B>feno_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feno_descripcion">feno_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feno_codigo">feno_codigo <FONT COLOR="#777777">smallint</FONT></TD></TR></TABLE>>];
 localizacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>localizacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="loca_id"><B>loca_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="loca_descripcion">loca_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="loca_codigo">loca_codigo <FONT COLOR="#777777">smallint</FONT></TD></TR></TABLE>>];
 municipio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>municipio</B></TD></TR><TR><TD ALIGN="LEFT" PORT="muni_id"><B>muni_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="muni_descripcion">muni_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="depa_id"><I>depa_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="muni_codigo">muni_codigo <FONT COLOR="#777777">character(3)</FONT></TD></TR></TABLE>>];
 norma [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>norma</B></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_id"><B>norm_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_codigo">norm_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_titulo">norm_titulo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_emisor">norm_emisor <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_anio">norm_anio <FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_texto_disponible">norm_texto_disponible <FONT COLOR="#777777">boolean</FONT></TD></TR></TABLE>>];
 producto_fitosanitario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>producto_fitosanitario</B></TD></TR><TR><TD ALIGN="LEFT" PORT="prof_id"><B>prof_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prof_nombre">prof_nombre <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prof_ingrediente_activo">prof_ingrediente_activo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prof_registro">prof_registro <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prof_activo">prof_activo <FONT COLOR="#777777">boolean</FONT></TD></TR></TABLE>>];
 rango_departamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>rango_departamento</B></TD></TR><TR><TD ALIGN="LEFT" PORT="depa_id"><B>depa_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rang_long_min">rang_long_min <FONT COLOR="#777777">float8</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rang_long_max">rang_long_max <FONT COLOR="#777777">float8</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rang_lat_min">rang_lat_min <FONT COLOR="#777777">float8</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rang_lat_max">rang_lat_max <FONT COLOR="#777777">float8</FONT></TD></TR></TABLE>>];
 region [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>region</B></TD></TR><TR><TD ALIGN="LEFT" PORT="regi_id"><B>regi_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="regi_descripcion">regi_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>rol</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_id"><B>rol_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_descripcion">rol_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_codigo">rol_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_ambito">rol_ambito <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 tipo_trampa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>tipo_trampa</B></TD></TR><TR><TD ALIGN="LEFT" PORT="tipt_id"><B>tipt_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipt_descripcion">tipt_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipt_paridad">tipt_paridad <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 unidad_medida [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>unidad_medida</B></TD></TR><TR><TD ALIGN="LEFT" PORT="unid_id"><B>unid_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unid_simbolo">unid_simbolo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unid_nombre">unid_nombre <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unid_magnitud">unid_magnitud <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 variedad_cultivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>variedad_cultivo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="vari_id"><B>vari_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="espc_id"><I>espc_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vari_descripcion">vari_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 vigilancia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbeafe" ALIGN="LEFT"><B>vigilancia</B></TD></TR><TR><TD ALIGN="LEFT" PORT="vigi_id"><B>vigi_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vigi_descripcion">vigi_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vigi_codigo">vigi_codigo <FONT COLOR="#777777">smallint</FONT></TD></TR></TABLE>>];
 departamento -> region;
 municipio -> departamento;
 rango_departamento -> departamento;
 centro_acopio -> departamento;
 variedad_cultivo -> especie_cultivo;
}