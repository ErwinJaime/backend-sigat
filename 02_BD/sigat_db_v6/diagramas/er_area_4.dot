digraph G {
 rankdir=LR; splines=true; nodesep=0.35; ranksep=0.9; fontname="Helvetica";
 node [shape=plain fontname="Helvetica" fontsize=9]; edge [color="#555555" arrowsize=0.7];
 trampa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fce7f3" ALIGN="LEFT"><B>trampa</B></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_id"><B>tram_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_codigo">tram_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_numero">tram_numero <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipt_id"><I>tipt_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atra_id"><I>atra_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esta_id"><I>esta_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_fecha_registro">tram_fecha_registro <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_fecha_actualizacion">tram_fecha_actualizacion <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_fecha_estado">tram_fecha_estado <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_tecnico_registro_id"><I>tram_tecnico_registro_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_tecnico_actualizacion_id"><I>tram_tecnico_actualizacion_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_tecnico_estado_id"><I>tram_tecnico_estado_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 ubicacion_trampa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fce7f3" ALIGN="LEFT"><B>ubicacion_trampa</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_id"><B>ubic_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tram_id"><I>tram_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pred_id"><I>pred_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lote_id"><I>lote_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_fecha">ubic_fecha <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_fecha_fin">ubic_fecha_fin <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tecn_id"><I>tecn_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vigi_id"><I>vigi_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_id"><I>ruta_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="retc_id"><I>retc_id</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="loca_id"><I>loca_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arbo_id"><I>arbo_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_long">ubic_long <FONT COLOR="#777777">numeric(8,5)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_lat">ubic_lat <FONT COLOR="#777777">numeric(7,5)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_alt">ubic_alt <FONT COLOR="#777777">float8</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_referencia">ubic_referencia <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_geom">ubic_geom <FONT COLOR="#777777">geometry(Point,4326)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_origen">ubic_origen <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ubic_registrado_en">ubic_registrado_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 ubicacion_trampa -> trampa;
}