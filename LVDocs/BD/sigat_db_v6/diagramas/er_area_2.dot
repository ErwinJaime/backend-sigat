digraph G {
 rankdir=LR; splines=true; nodesep=0.35; ranksep=0.9; fontname="Helvetica";
 node [shape=plain fontname="Helvetica" fontsize=9]; edge [color="#555555" arrowsize=0.7];
 administrador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>administrador</B></TD></TR><TR><TD ALIGN="LEFT" PORT="admi_id"><B>admi_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_cc"><I>pers_cc</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cent_id"><I>cent_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 permiso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>permiso</B></TD></TR><TR><TD ALIGN="LEFT" PORT="perm_id"><B>perm_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perm_codigo">perm_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perm_descripcion">perm_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>persona</B></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_cc"><B>pers_cc</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_nombre">pers_nombre <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_apellido">pers_apellido <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_telefono">pers_telefono <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_direccion">pers_direccion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_correo">pers_correo <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 productor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>productor</B></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_cc"><B>pers_cc</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prod_fecha_registro">prod_fecha_registro <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prod_fecha_actualizacion">prod_fecha_actualizacion <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prod_tecnico_registro_id"><I>prod_tecnico_registro_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prod_tecnico_actualizacion_id"><I>prod_tecnico_actualizacion_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prod_activo">prod_activo <FONT COLOR="#777777">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="muni_id"><I>muni_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 rol_permiso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>rol_permiso</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_id"><B>rol_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perm_id"><B>perm_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 ruta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>ruta</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_id"><B>ruta_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_nombre">ruta_nombre <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cent_id"><I>cent_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="muni_id"><I>muni_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_descripcion">ruta_descripcion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_codigo">ruta_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_fecha_registro">ruta_fecha_registro <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_fecha_actualizacion">ruta_fecha_actualizacion <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_admin_registro_id"><I>ruta_admin_registro_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_admin_actualizacion_id"><I>ruta_admin_actualizacion_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esta_id"><I>esta_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 tecnico [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>tecnico</B></TD></TR><TR><TD ALIGN="LEFT" PORT="tecn_id"><B>tecn_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_cc"><I>pers_cc</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cent_id"><I>cent_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tecn_codigo">tecn_codigo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="admi_id"><I>admi_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tecn_fecha_registro">tecn_fecha_registro <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tecn_fecha_actualizacion">tecn_fecha_actualizacion <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esta_id"><I>esta_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR></TABLE>>];
 usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><B>usuario</B></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><B>usua_id</B> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pers_cc"><I>pers_cc</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_usuario">usua_usuario <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_contrasena">usua_contrasena <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_proveedor">usua_proveedor <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_sujeto_externo">usua_sujeto_externo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_requiere_reinicio">usua_requiere_reinicio <FONT COLOR="#777777">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_id"><I>rol_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esta_id"><I>esta_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_ultimo_acceso">usua_ultimo_acceso <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 administrador -> persona;
 tecnico -> persona;
 tecnico -> administrador;
 productor -> persona;
 productor -> tecnico;
 productor -> tecnico;
 ruta -> administrador;
 ruta -> administrador;
 usuario -> persona;
 rol_permiso -> permiso;
}