digraph G {
 rankdir=LR; splines=true; nodesep=0.35; ranksep=0.9; fontname="Helvetica";
 node [shape=plain fontname="Helvetica" fontsize=9]; edge [color="#555555" arrowsize=0.7];
 concepto_aptitud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#ede9fe" ALIGN="LEFT"><B>concepto_aptitud</B></TD></TR><TR><TD ALIGN="LEFT" PORT="conc_id"><B>conc_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lote_id"><I>lote_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_id"><I>peri_id</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_id"><I>indi_id</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conc_version">conc_version <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conc_resultado">conc_resultado <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conc_fecha_efecto">conc_fecha_efecto <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_id"><I>norm_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conc_emitido_en">conc_emitido_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conc_motivo">conc_motivo <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 indice_mtd [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#ede9fe" ALIGN="LEFT"><B>indice_mtd</B></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_id"><B>indi_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_id"><I>peri_id</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="espm_id"><I>espm_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_version">indi_version <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_moscas">indi_moscas <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_trampas">indi_trampas <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_dias_exposicion">indi_dias_exposicion <FONT COLOR="#777777">numeric(8,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_valor">indi_valor <FONT COLOR="#777777">numeric(14,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_unidad">indi_unidad <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_umbral_aplicado">indi_umbral_aplicado <FONT COLOR="#777777">numeric(10,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="norm_id"><I>norm_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_resultado_contraste">indi_resultado_contraste <FONT COLOR="#777777">sigat.d_resultado_cont</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="esce_id"><I>esce_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_calculado_en">indi_calculado_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_motivo_recalculo">indi_motivo_recalculo <FONT COLOR="#777777">varchar</FONT></TD></TR></TABLE>>];
 indice_mtd_lectura [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#ede9fe" ALIGN="LEFT"><B>indice_mtd_lectura</B></TD></TR><TR><TD ALIGN="LEFT" PORT="indi_id"><B>indi_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lect_id"><B>lect_id</B> <FONT COLOR="#777777">uuid</FONT></TD></TR></TABLE>>];
 periodo_trampeo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#ede9fe" ALIGN="LEFT"><B>periodo_trampeo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_id"><B>peri_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lote_id"><I>lote_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vigi_id"><I>vigi_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prog_id"><I>prog_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_inicio">peri_inicio <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_fin">peri_fin <FONT COLOR="#777777">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_estado">peri_estado <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peri_creado_en">peri_creado_en <FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 indice_mtd -> periodo_trampeo;
 indice_mtd_lectura -> indice_mtd;
 concepto_aptitud -> periodo_trampeo;
 concepto_aptitud -> indice_mtd;
}