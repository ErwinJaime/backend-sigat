 operacion_sync [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e5e7eb" ALIGN="LEFT"><B>operacion_sync</B></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_id"><B>oper_id</B> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="disp_id"><I>disp_id</I> <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_cliente_id">oper_cliente_id <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usua_id"><I>usua_id</I> <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_entidad">oper_entidad <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_accion">oper_accion <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_registro_id">oper_registro_id <FONT COLOR="#777777">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_version">oper_version <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_hash_contenido">oper_hash_contenido <FONT COLOR="#777777">character(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_clasificacion">oper_clasificacion <FONT COLOR="#777777">sigat.d_clasificacion_</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_motivo">oper_motivo <FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_t_captura">oper_t_captura <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_t_recepcion">oper_t_recepcion <FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_deriva_reloj_seg">oper_deriva_reloj_seg <FONT COLOR="#777777">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_resuelve_oper_id"><I>oper_resuelve_oper_id</I> <FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oper_payload">oper_payload <FONT COLOR="#777777">jsonb</FONT></TD></TR></TABLE>>];
