Project sigat { database_type: 'PostgreSQL' }

Table trampa {
  tram_id integer [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  tram_codigo varchar [unique, note: 'Código oficial impreso en la trampa. Formato verificado de forma mínima (el Manual Técnico T1 no está disponible): ver pendientes.']
  tram_numero integer [note: 'Número de trampa extraído del código (columna generada). Jackson impar / McPhail par (RN-005).']
  tipt_id integer [not null, note: 'Referencia a tipo_trampa(tipt_id).']
  atra_id integer [not null, note: 'Referencia a atrayente(atra_id).']
  esta_id integer [not null, note: 'Referencia a estado_registro(esta_id).']
  tram_fecha_registro date [not null, note: 'Fecha de registro de la trampa.']
  tram_fecha_actualizacion date [note: 'Fecha de la última actualización del registro.']
  tram_fecha_estado date [note: 'Fecha del último cambio de estado (esta_id) de la trampa.']
  tram_tecnico_registro_id integer [not null, note: 'Técnico que registró la trampa. Referencia a tecnico(tecn_id).']
  tram_tecnico_actualizacion_id integer [note: 'Técnico que hizo la última actualización de la trampa. Referencia a tecnico(tecn_id).']
  tram_tecnico_estado_id integer [note: 'Técnico que cambió por última vez el estado de la trampa. Referencia a tecnico(tecn_id).']
}

Table ubicacion_trampa {
  ubic_id bigint [pk, not null, increment, note: 'Identificador del registro (clave primaria).']
  tram_id integer [not null, note: 'Referencia a trampa(tram_id).']
  pred_id integer [not null, note: 'Redundancia controlada: lote_id determina pred_id; la FK compuesta (lote_id, pred_id) impide la incoherencia. Permite conservar filas heredadas sin lote.']
  lote_id integer [note: 'Referencia a lote(lote_id).']
  ubic_fecha date [not null, note: 'Fecha de instalación en este puesto (inclusive). ubic_fecha_fin = primer día en que ya no está (exclusivo; retiro o reubicación).']
  ubic_fecha_fin date [note: 'Primer día en que la trampa ya no está en este puesto (exclusivo); nulo = vigente.']
  tecn_id integer [not null, note: 'Referencia a tecnico(tecn_id).']
  vigi_id integer [not null, note: 'Referencia a vigilancia(vigi_id).']
  ruta_id integer [note: 'Referencia a ruta(ruta_id).']
  retc_id bigint [note: 'Referencia a reticula_celda(retc_id).']
  loca_id integer [note: 'Referencia a localizacion(loca_id).']
  arbo_id integer [note: 'Referencia a arbol(arbo_id).']
  ubic_long numeric(8,5) [not null, note: '[ud: grados decimales WGS84] 5 decimales (RN-006); numeric evita ruido de punto flotante.']
  ubic_lat numeric(7,5) [not null, note: '[ud: grados decimales WGS84] Latitud con 5 decimales (RN-006).']
  ubic_alt float8 [note: '[ud: m s. n. m.] Altitud; puede faltar si el GPS no la entrega.']
  ubic_referencia varchar [note: 'Descripción libre del sitio (opcional).']
  ubic_geom "geometry(Point,4326)" [note: 'Punto SRID 4326 derivado de ubic_long/ubic_lat (columna generada: una sola fuente de verdad). Base de ST_Contains contra lote_geometria.']
  ubic_origen varchar [not null, default: `'operacion'::character varying`, note: 'operacion = creada con las reglas vigentes; legado = migrada del esquema anterior sin lote asignado.']
  ubic_registrado_en timestamptz [not null, default: `now()`, note: 'Momento en que se registró la ubicación.']
  indexes {
    (ubic_id, tram_id) [unique]
  }
}

Ref: ubicacion_trampa.tram_id > trampa.tram_id
